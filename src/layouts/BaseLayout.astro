---
import "../styles/global.css";
import Background from "../components/Background.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../config/site";
import { isProductionBranchBuild } from "../utils/production-branch";
import newBlackLight from "../assets/fonts/newblack-light.woff2?url";
import ownersRegular from "../assets/fonts/owners-xwide-regular.woff2?url";

interface Props {
  title: string;
  description?: string;
  /** Override the canonical URL; defaults to the current page URL on Astro.site. */
  canonical?: string;
  /** Open Graph image path or URL; defaults to the site-wide image. */
  ogImage?: string;
  /** Exclude this single page from search engines. */
  noindex?: boolean;
}

const {
  title,
  description = SITE.defaultDescription,
  canonical,
  ogImage = SITE.ogImage,
  noindex = false,
} = Astro.props;

const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const ogImageURL = new URL(ogImage, Astro.site).href;

// Only an actual Cloudflare Workers Builds build of `main` is indexable.
// Staging, feature branches, and builds without WORKERS_CI_BRANCH fail safe
// to noindex. See src/utils/production-branch.ts.
const isProduction = isProductionBranchBuild();
const isNoindex = noindex || !isProduction;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {isNoindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {isProduction && <link rel="sitemap" href="/sitemap-index.xml" />}
    <meta name="theme-color" content="#070707" />
    <meta name="generator" content={Astro.generator} />

    <!-- Most-used brand faces: body copy and the claim. -->
    <link rel="preload" href={newBlackLight} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={ownersRegular} as="font" type="font/woff2" crossorigin />

    <!-- Lets CSS hide scroll-reveal content only when JS will reveal it. -->
    <script is:inline>document.documentElement.classList.add("js");</script>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta name="twitter:card" content="summary_large_image" />

    <!--
      Analytics: client projects inject approved snippets through this slot
      from their pages/layouts. Nothing is loaded by default. See README.
    -->
    <slot name="head" />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:bg-negro focus:px-4 focus:py-2 focus:text-blanco"
    >
      Saltar al contenido principal
    </a>
    <Background />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
