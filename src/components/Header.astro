---
import { SITE } from "../config/site";
---

<header class="border-b border-edge bg-surface">
  <div
    class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-4 sm:px-6"
  >
    <a href="/" class="text-lg font-semibold tracking-tight text-ink">
      {SITE.name}
    </a>
    <nav aria-label="Main">
      <ul class="flex flex-wrap items-center gap-x-6 gap-y-1">
        {
          SITE.nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-sm font-medium text-ink-muted transition-colors hover:text-ink"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
