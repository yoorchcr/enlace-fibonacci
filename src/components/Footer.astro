---
import { SITE } from "../config/site";

const year = new Date().getFullYear();
---

<footer class="border-t border-edge bg-surface-muted">
  <div
    class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-8 sm:px-6"
  >
    <p class="text-sm text-ink-muted">
      &copy; {year} {SITE.name}. All rights reserved.
    </p>
    <nav aria-label="Footer">
      <ul class="flex flex-wrap items-center gap-x-6 gap-y-1">
        {
          SITE.nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-sm text-ink-muted transition-colors hover:text-ink"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>
