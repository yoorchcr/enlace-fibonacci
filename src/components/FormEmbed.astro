---
import Button from "./Button.astro";

/**
 * Responsive wrapper for an external form embedded via iframe
 * (e.g. Tally, Typeform, HubSpot).
 *
 * When no `src` is provided it renders an accessible CTA fallback
 * instead, so pages can ship before the client's form exists.
 * Remember to allow the form origin in the deployment CSP
 * (see docs/deployment-security.md).
 */
interface Props {
  /** External form URL. Omit to render the CTA fallback. */
  src?: string;
  /** Accessible name for the iframe. Required even in fallback mode. */
  title: string;
  /** Iframe height in pixels; adjust to the embedded form's natural height. */
  height?: number;
  /**
   * Fallback CTA target, e.g. a mailto: or contact URL.
   * No default on purpose: omitting it hides the CTA button rather than
   * shipping a placeholder contact address by accident.
   */
  fallbackHref?: string;
  fallbackLabel?: string;
}

const {
  src,
  title,
  height = 480,
  fallbackHref,
  fallbackLabel = "Contact us",
} = Astro.props;
---

{
  src ? (
    <div class="overflow-hidden rounded-(--radius-panel) border border-edge bg-surface">
      <iframe
        src={src}
        title={title}
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"
        class="block w-full border-0"
        style={`height: ${height}px`}
      />
    </div>
  ) : (
    <div class="rounded-(--radius-panel) border border-edge bg-surface px-6 py-12 text-center">
      <slot name="fallback">
        <h3 class="text-lg font-semibold text-ink">{title}</h3>
        <p class="mx-auto mt-2 max-w-md text-sm text-ink-muted">
          Our form is not available right now. Reach out directly and we will
          get back to you.
        </p>
        {fallbackHref && (
          <div class="mt-6">
            <Button href={fallbackHref}>{fallbackLabel}</Button>
          </div>
        )}
      </slot>
    </div>
  )
}
