---
/**
 * Opening section: the brand symbol with its provisional entrance animation
 * (the two pieces join) and a scroll cue to the photograph.
 *
 * HEADER ANIMATION SLOT: while the final animation is in development, the
 * symbol lives in #hero-animation. To replace it, swap that element's content
 * (video, Lottie, canvas, or SVG) without touching the rest of the hero.
 */
---

<header class="hero" id="inicio">
  <h1 class="hero__title">
    <span class="sr-only">Enlace Fibonacci</span>
    <span class="hero__stage" id="hero-animation">
      <svg class="symbol" viewBox="0 0 785.91 704.89" aria-hidden="true" focusable="false">
        <path
          class="symbol__a"
          d="M443.36,262.48l-92.12.58-5.5.03h-3.76s-51.76-.15-51.76-.15c0,0,.66.15,1.83.48,2.8.79,5.53,1.81,8.2,2.96,4.21,1.81,8.27,3.99,12.09,6.53,4.71,3.13,9.06,6.81,12.83,11.03,4.36,4.88,7.9,10.45,10.43,16.48,3.04,7.25,4.58,15.05,4.91,22.88.41,9.64.14,19.48-2.86,28.72-2.78,8.56-7.16,16.67-12.63,23.8-3.38,4.4-7.25,8.6-11.75,11.88,0,0-81.93,61.44-81.93,61.44-14.59,10.95-26.13,6.19-25.77-10.61l1.99-92.11,1.63-75.51c0-.28.01-.55.01-.84.35-15.84-3.83-26.31-7.53-32.42-.01-.01-.01-.03-.03-.03-2.39-3.95-5.7-7.29-8.62-10.84-9.04-11.01-17.74-22.33-26.6-33.49l-22.94-28.87c-1.75-2.21-3.51-4.42-5.26-6.63-11.36-14.28-6.92-25.95,9.9-26.06l183.93-1.14h1.78s4.7-.04,4.7-.04c16.82-.1,39.65,11.39,51,25.67l63.7,80.2c11.34,14.28,6.92,25.95-9.9,26.05Z"
        ></path>
        <path
          class="symbol__b"
          d="M344.43,438.92l92.12-.58,5.5-.03h3.76s51.76.15,51.76.15c0,0-.66-.15-1.83-.48-2.8-.79-5.53-1.81-8.2-2.96-4.21-1.81-8.27-3.99-12.09-6.53-4.71-3.13-9.06-6.81-12.83-11.03-4.36-4.88-7.9-10.45-10.43-16.48-3.04-7.25-4.58-15.05-4.91-22.88-.41-9.64-.14-19.48,2.86-28.72,2.78-8.56,7.16-16.67,12.63-23.8,3.38-4.4,7.25-8.6,11.75-11.88,0,0,81.93-61.44,81.93-61.44,14.59-10.95,26.13-6.19,25.77,10.61l-1.99,92.11-1.63,75.51c0,.28-.01.55-.01.84-.35,15.84,3.83,26.31,7.53,32.42.01.01.01.03.03.03,2.39,3.95,5.7,7.29,8.62,10.84,9.04,11.01,17.74,22.33,26.6,33.49,7.65,9.62,15.29,19.25,22.94,28.87,1.75,2.21,3.51,4.42,5.26,6.63,11.36,14.28,6.92,25.95-9.9,26.06l-183.93,1.14h-1.78s-4.7.04-4.7.04c-16.82.1-39.65-11.39-51-25.67l-63.7-80.2c-11.34-14.28-6.92-25.95,9.9-26.05Z"
        ></path>
      </svg>
    </span>
  </h1>

  <a class="hero__scroll" href="#fotografia" aria-label="Bajar a la fotografía">
    <span class="hero__scroll-line"></span>
  </a>
</header>

<style>
  .hero {
    position: relative;
    height: 78vh;
    height: 78svh;
    min-height: 440px;
    display: grid;
    place-items: center;
  }

  .hero__stage {
    position: relative;
    z-index: 3;
    display: block;
    width: clamp(88px, 10vw, 150px);
    transform: translate3d(var(--mx, 0px), var(--my, 0px), 0);
    transition: transform 0.8s var(--ease);
  }

  /* Inline, as in the artifact: the baseline gap keeps the symbol's exact position. */
  .symbol {
    display: inline;
    vertical-align: baseline;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .symbol path {
    fill: var(--color-blanco);
  }

  /* Provisional entrance: the two pieces join (the "enlace"). */
  .symbol__a {
    animation: join-a 1.8s var(--ease) 0.3s both;
  }

  .symbol__b {
    animation: join-b 1.8s var(--ease) 0.3s both;
  }

  @keyframes join-a {
    from {
      opacity: 0;
      transform: translate(-90px, -70px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes join-b {
    from {
      opacity: 0;
      transform: translate(90px, 70px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Safety net: if the entrance never runs, the symbol is shown anyway. */
  .symbol.is-ready path {
    animation: none;
    opacity: 1;
    transform: none;
  }

  .hero__scroll {
    position: absolute;
    z-index: 3;
    left: 50%;
    bottom: clamp(24px, 5vh, 48px);
    width: 24px;
    height: 64px;
    transform: translateX(-50%);
    display: flex;
    justify-content: center;
    animation: fade-in 1s ease 2s both;
  }

  .hero__scroll-line {
    position: relative;
    width: 1px;
    height: 100%;
    background: rgba(246, 246, 246, 0.18);
    overflow: hidden;
  }

  .hero__scroll-line::after {
    content: "";
    position: absolute;
    left: 0;
    top: -40%;
    width: 1px;
    height: 40%;
    background: var(--color-blanco);
    animation: scroll-cue 2.2s var(--ease) infinite;
  }

  @keyframes scroll-cue {
    to {
      top: 100%;
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__stage {
      transition: none;
    }

    .symbol path,
    .hero__scroll {
      animation: none;
    }

    .hero__scroll-line::after {
      top: 30%;
      animation: none;
    }
  }
</style>

<script>
  // Safety net: if the entrance animation is delayed, show the symbol at 3.5 s.
  const symbol = document.querySelector(".symbol");
  if (symbol) {
    setTimeout(() => symbol.classList.add("is-ready"), 3500);
  }

  // The symbol follows the cursor slightly (placeholder until the final animation).
  const hero = document.querySelector<HTMLElement>(".hero");
  const stage = document.getElementById("hero-animation");
  const canFollowPointer =
    window.matchMedia("(pointer: fine)").matches &&
    !window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (hero && stage && canFollowPointer) {
    hero.addEventListener("pointermove", (event) => {
      const x = (event.clientX / window.innerWidth - 0.5) * 18;
      const y = (event.clientY / window.innerHeight - 0.5) * 18;
      stage.style.setProperty("--mx", `${x.toFixed(1)}px`);
      stage.style.setProperty("--my", `${y.toFixed(1)}px`);
    });
    hero.addEventListener("pointerleave", () => {
      stage.style.setProperty("--mx", "0px");
      stage.style.setProperty("--my", "0px");
    });
  }
</script>
